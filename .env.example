# ==== Auto Subtitle — cấu hình môi trường (mẫu, KHÔNG chứa secret thật) ====
# Sao chép thành .env rồi điền giá trị thật. .env đã bị .gitignore.

# --- Deploy VPS (docker-compose.prod.yml) ---
# Compose tự dựng DATABASE_URL/REDIS_URL cho container từ 3 biến dưới đây, nên khi
# deploy bằng compose bạn CHỈ cần đặt POSTGRES_PASSWORD (bắt buộc). Hai biến DATABASE_URL/
# REDIS_URL bên dưới chỉ dùng khi chạy trực tiếp trên máy (dev), không qua compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_DB=dakatool

# --- Database (PostgreSQL) — dùng khi chạy dev cục bộ (không qua compose) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dakatool?schema=public"

# --- Redis (BullMQ) — dùng khi chạy dev cục bộ (không qua compose) ---
REDIS_URL="redis://localhost:6379"

# --- Deploy Vercel (chỉ module Quản lý công trình) ---
# Xem docs/deploy-vercel.md. Trên Vercel BẮT BUỘC:
#   DATABASE_URL   → Postgres managed (Neon/Supabase), dùng chuỗi POOLED.
#   STORAGE_DRIVER=s3 + đủ 4 biến S3_* bên dưới — ổ đĩa của Vercel là read-only
#                    và mất sau mỗi lần deploy nên STORAGE_DRIVER=local sẽ hỏng.
# Không cần REDIS_URL (module công trình không dùng queue/worker).

# --- Storage ---
# local = lưu ổ đĩa (LOCAL_STORAGE_ROOT); s3 = S3/R2/MinIO.
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=./data
# Khi STORAGE_DRIVER=s3 (điền secret thật ở .env, không commit):
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=            # R2/MinIO cần endpoint; AWS để trống
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# --- Giới hạn upload ---
MAX_VIDEO_SIZE_BYTES=1073741824    # 1 GB
MAX_VIDEO_DURATION_SECONDS=7200    # 2 giờ

# --- Whisper / engine ---
WHISPER_MODEL=small                # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu                 # cpu | cuda
WHISPER_COMPUTE_TYPE=int8          # int8 | int8_float16 | float16 | float32
WHISPER_LANGUAGE=vi                # ngôn ngữ mặc định gợi ý (UI có thể chọn auto/vi/en/ja)
WHISPER_BEAM_SIZE=5
WHISPER_VAD_ENABLED=true

# --- Worker ---
WORKER_CONCURRENCY=1               # 1 = không transcribe hai video cùng lúc
JOB_TIMEOUT_MS=3600000             # 1 giờ

# --- Đường dẫn engine ---
SUBTITLE_ENGINE_PYTHON=python3
SUBTITLE_ENGINE_DIR=./services/subtitle-engine
SUBTITLE_FONTS_DIR=./assets/fonts
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
