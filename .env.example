# DakaTool — cấu hình môi trường mẫu, không chứa secret thật.

# PostgreSQL/Supabase dùng cho dữ liệu server-side và lịch sử phiếu thanh toán.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dakatool?schema=public"

# Mã truy cập nội bộ. Đặt biến này trong Vercel cho Production và Preview.
DAKATOOL_ACCESS_CODE="change-me"

# Storage: local cho phát triển; s3 cho Vercel/R2/MinIO/AWS.
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=./data

# Bắt buộc khi STORAGE_DRIVER=s3:
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Marketing: đăng bài Fanpage (xem docs/marketing-setup.md).
# Meta App có Facebook Login; trưởng nhóm bấm "Kết nối Facebook" trong DakaTool để chọn Fanpage.
# KHÔNG commit App Secret thật.
FB_APP_ID=""
FB_APP_SECRET=""
# FB_GRAPH_VERSION=v26.0
# Mã riêng cho trưởng nhóm MKT để duyệt/đăng/huỷ lịch bài.
MKT_APPROVER_CODE=""
