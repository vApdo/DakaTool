// Prisma schema cho các module dùng dữ liệu server-side của DakaTool.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Cấu hình nội bộ dạng key-value, chỉ đọc/ghi phía server.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Giới hạn số lần nhập sai mã truy cập theo IP trên môi trường serverless.
model AppAccessAttempt {
  ip        String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

enum PaymentRequestAction {
  DOWNLOAD
  PRINT
}

/// Ảnh chụp dữ liệu của một phiếu tại thời điểm tải PDF hoặc in.
model PaymentRequestHistory {
  id            String               @id @default(cuid())
  action        PaymentRequestAction
  requestDate   String
  requesterName String
  department    String
  companyName   String
  totalVnd      BigInt
  snapshot      Json
  createdAt     DateTime             @default(now())

  @@index([createdAt])
}

// ===== Quản lý công trình xây dựng (Xưởng cơ khí HQT) =====

/// Đếm số lần nhập sai mã quản lý theo IP, để chống dò mã.
/// Phải nằm ở DB chứ không phải bộ nhớ tiến trình: khi chạy serverless (Vercel)
/// mỗi instance có bộ nhớ riêng, kẻ dò mã chỉ cần rơi vào instance khác là được
/// đếm lại từ đầu.
model ConstructionAuthAttempt {
  ip        String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

enum ConstructionStatus {
  PLANNING
  IN_PROGRESS
  PAUSED
  COMPLETED
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  DELAYED
}

enum ConstructionFileKind {
  PLAN
  BUDGET
  OTHER
}

model ConstructionProject {
  id          String             @id @default(cuid())
  name        String
  description String?
  status      ConstructionStatus @default(IN_PROGRESS)
  startDate   DateTime?
  targetDate  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  updates    ConstructionUpdate[]
  milestones ConstructionMilestone[]
  costItems  ConstructionCostItem[]
  files      ConstructionFile[]
}

/// Một lần đăng nhật ký tiến độ của quản lý (chú thích + chùm ảnh).
model ConstructionUpdate {
  id         String   @id @default(cuid())
  projectId  String
  note       String
  authorName String?
  createdAt  DateTime @default(now())

  project ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  photos  ConstructionPhoto[]

  @@index([projectId, createdAt])
}

model ConstructionPhoto {
  id         String  @id @default(cuid())
  updateId   String
  storageKey String
  caption    String?
  sortOrder  Int     @default(0)

  update ConstructionUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)

  @@index([updateId])
}

model ConstructionMilestone {
  id           String          @id @default(cuid())
  projectId    String
  name         String
  plannedStart DateTime?
  plannedEnd   DateTime?
  status       MilestoneStatus @default(NOT_STARTED)
  percent      Int             @default(0)
  note         String?
  sortOrder    Int             @default(0)

  project ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ConstructionCostItem {
  id           String  @id @default(cuid())
  projectId    String
  name         String
  estimatedVnd BigInt
  actualVnd    BigInt  @default(0)
  note         String?
  sortOrder    Int     @default(0)

  project ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ConstructionFile {
  id         String               @id @default(cuid())
  projectId  String
  kind       ConstructionFileKind @default(OTHER)
  filename   String
  storageKey String
  sizeBytes  BigInt
  createdAt  DateTime             @default(now())

  project ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ===== Marketing: soạn và đăng bài lên Fanpage =====

enum MktPostStatus {
  DRAFT
  /// Đang gửi lên Facebook — chặn bấm đăng hai lần thành bài trùng.
  PUBLISHING
  SCHEDULED
  PUBLISHED
  FAILED
}

/// Một bài viết cho Fanpage, từ lúc soạn nháp tới khi đã đăng.
model MktPost {
  id           String        @id @default(cuid())
  fbPageId     String
  pageName     String
  status       MktPostStatus @default(DRAFT)
  message      String
  link         String?
  /// null = đăng ngay khi bấm Đăng.
  scheduledAt  DateTime?
  authorName   String
  /// id bài trên Facebook dạng "{pageId}_{postId}", có khi đã lên lịch hoặc đã đăng.
  fbPostId     String?
  permalinkUrl String?
  publishedAt  DateTime?
  lastError    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  media  MktPostMedia[]
  metric MktPostMetric?

  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
}

model MktPostMedia {
  id          String @id @default(cuid())
  postId      String
  storageKey  String
  contentType String
  sizeBytes   Int
  sortOrder   Int    @default(0)

  post MktPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

/// Bản chụp số liệu gần nhất lấy từ Facebook, để không gọi API mỗi lần mở trang.
model MktPostMetric {
  postId      String   @id
  views       Int?
  uniqueViews Int?
  clicks      Int?
  reactions   Int?
  comments    Int?
  shares      Int?
  fetchedAt   DateTime

  post MktPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}

/// Fanpage đã kết nối qua "Kết nối Facebook". Page token được mã hoá bằng khoá suy ra từ FB_APP_SECRET.
model MktPageConnection {
  pageId         String   @id
  pageName       String
  encryptedToken String
  /// Tên tài khoản Facebook đã bấm kết nối — kết nối mất hiệu lực nếu người này mất quyền Fanpage.
  connectedBy    String
  connectedAt    DateTime @default(now())
}
