// Prisma schema cho tính năng Auto Subtitle của DakaTool.
// Chỉ chứa các entity phục vụ Auto Subtitle; các tool PDF client-side không dùng DB.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  UPLOADING
  UPLOADED
  QUEUED
  EXTRACTING_AUDIO
  TRANSCRIBING
  FORMATTING
  READY
  RENDERING
  COMPLETED
  FAILED
}

enum JobType {
  TRANSCRIBE
  RENDER_VIDEO
  GENERATE_EXPORT
}

enum JobStatus {
  QUEUED
  ACTIVE
  COMPLETED
  FAILED
  CANCELLED
}

enum ExportType {
  SRT
  VTT
  ASS
  BURNED_MP4
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Cấu hình toàn cục dạng key-value (provider nhận dạng, model, API key AI…).
/// Chỉ đọc/ghi phía server; API key KHÔNG bao giờ trả về client.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ===== Quản lý công trình xây dựng (Xưởng cơ khí HQT) =====

/// Đếm số lần nhập sai mã quản lý theo IP, để chống dò mã.
/// Phải nằm ở DB chứ không phải bộ nhớ tiến trình: khi chạy serverless (Vercel)
/// mỗi instance có bộ nhớ riêng, kẻ dò mã chỉ cần rơi vào instance khác là được
/// đếm lại từ đầu.
model ConstructionAuthAttempt {
  ip        String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

enum ConstructionStatus {
  PLANNING
  IN_PROGRESS
  PAUSED
  COMPLETED
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  DELAYED
}

enum ConstructionFileKind {
  PLAN
  BUDGET
  OTHER
}

model ConstructionProject {
  id          String             @id @default(cuid())
  name        String
  description String?
  status      ConstructionStatus @default(IN_PROGRESS)
  startDate   DateTime?
  targetDate  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  updates    ConstructionUpdate[]
  milestones ConstructionMilestone[]
  costItems  ConstructionCostItem[]
  files      ConstructionFile[]
}

/// Một lần đăng nhật ký tiến độ của quản lý (chú thích + chùm ảnh).
model ConstructionUpdate {
  id         String   @id @default(cuid())
  projectId  String
  note       String
  authorName String?
  createdAt  DateTime @default(now())

  project ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  photos  ConstructionPhoto[]

  @@index([projectId, createdAt])
}

model ConstructionPhoto {
  id         String  @id @default(cuid())
  updateId   String
  storageKey String
  caption    String?
  sortOrder  Int     @default(0)

  update ConstructionUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)

  @@index([updateId])
}

model ConstructionMilestone {
  id           String          @id @default(cuid())
  projectId    String
  name         String
  plannedStart DateTime?
  plannedEnd   DateTime?
  status       MilestoneStatus @default(NOT_STARTED)
  percent      Int             @default(0)
  note         String?
  sortOrder    Int             @default(0)

  project ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ConstructionCostItem {
  id           String  @id @default(cuid())
  projectId    String
  name         String
  estimatedVnd BigInt
  actualVnd    BigInt  @default(0)
  note         String?
  sortOrder    Int     @default(0)

  project ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ConstructionFile {
  id         String               @id @default(cuid())
  projectId  String
  kind       ConstructionFileKind @default(OTHER)
  filename   String
  storageKey String
  sizeBytes  BigInt
  createdAt  DateTime             @default(now())

  project ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model SubtitleProject {
  id                String        @id @default(cuid())
  ownerId           String?
  title             String
  sourceFilename    String
  sourceMimeType    String
  sourceSizeBytes   BigInt
  sourceStorageKey  String
  durationMs        Int?
  detectedLanguage  String?
  requestedLanguage String
  /// Tách giọng nói khỏi nhạc nền (Demucs) trước khi nhận dạng — cho video nhạc to/bài hát.
  separateVocals    Boolean       @default(false)
  status            ProjectStatus @default(UPLOADING)
  progress          Int           @default(0)
  errorCode         String?
  errorMessage      String?
  subtitleStyle     Json
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  completedAt       DateTime?

  segments SubtitleSegment[]
  jobs     SubtitleJob[]
  exports  SubtitleExport[]

  @@index([createdAt])
}

model SubtitleSegment {
  id        String   @id @default(cuid())
  projectId String
  order     Int
  startMs   Int
  endMs     Int
  text      String
  speaker   String?
  words     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project SubtitleProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, order])
  @@index([projectId])
}

model SubtitleJob {
  id           String    @id @default(cuid())
  projectId    String
  bullJobId    String?
  type         JobType
  status       JobStatus @default(QUEUED)
  progress     Int       @default(0)
  attempts     Int       @default(0)
  errorCode    String?
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project SubtitleProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model SubtitleExport {
  id           String       @id @default(cuid())
  projectId    String
  type         ExportType
  status       ExportStatus @default(PENDING)
  storageKey   String?
  filename     String
  mimeType     String
  sizeBytes    BigInt?
  errorMessage String?
  createdAt    DateTime     @default(now())
  completedAt  DateTime?

  project SubtitleProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}
